services:
  wg-easy:
    image: ghcr.io/wg-easy/wg-easy:latest
    container_name: wg-easy
    hostname: wg-easy

    environment:
      - WG_HOST=wirednssya.duckdns.org
      - PASSWORD_HASH=TU_HASH_BCRYPT
      - WG_DEFAULT_DNS=10.8.1.3

    volumes:
      - /home/wg-easy:/etc/wireguard

    ports:
      - "51820:51820/udp"
      - "51821:51821/tcp"

    restart: unless-stopped

    cap_add:
      - NET_ADMIN
      - SYS_MODULE

    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1

    networks:
      vpn:
        ipv4_address: 10.8.1.4

  pihole:
    image: pihole/pihole:latest
    container_name: pihole
    hostname: pihole

    environment:
      - TZ=America/Bogota
      - WEBPASSWORD=TU_PASSWORD

    volumes:
      - /home/pihole/etc-pihole:/etc/pihole
      - /home/pihole/etc-dnsmasq.d:/etc/dnsmasq.d

    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "5353:80/tcp"

    restart: unless-stopped

    networks:
      vpn:
        ipv4_address: 10.8.1.3

networks:
  vpn:
    driver: bridge
    ipam:
      config:
        - subnet: 10.8.1.0/24
